# Dependencies
node_modules/
**/node_modules/

# The native folder, generated once by bootstrap.sh and patched by the
# scripts, is IN the repo: F-Droid builds from what is committed, and a
# skeleton fetched from npm at build time would be neither reproducible
# nor allowed. What gradle produces stays out.
app/android/.gradle/
app/android/.cxx/
app/android/app/.cxx/
app/android/local.properties
app/android/.kotlin/
app/ios/
app/ios/
app/Gemfile
app/.watchmanconfig

# Build / cache
app/android/app/build/
**/build/
.gradle/
*.apk
*.aab

# Metro / RN
.metro-health-check*
app/.expo/

# Secrets / local config
server/.env
*.local

# Logs and system
*.log
.DS_Store
npm-debug.log*
yarn-error.log*

# Editor
.idea/
.vscode/

# Python leftovers from assets/make-sounds.py
__pycache__/

# The phones let in by invitation: they belong to one server, not to the code
server/devices.json

# Personal Claude Code commands: they point at conversation transcripts on
# one machine, which are private and exist nowhere else.
.claude/
