#!/bin/sh
# Duetto: a relay user per phone, made and dropped in coturn's database.
#
#   duetto-turnuser add <user> <password>
#   duetto-turnuser del <user>
#
# Run by the signalling server through sudo (see deploy/sudoers-duetto-turnuser):
# the user is letters and figures only, the password too, and the realm
# is the one in /etc/turnserver.conf. Nothing else can be passed through.
set -eu
op=${1:-}; u=${2:-}; p=${3:-}
case "$u" in ""|*[!a-z0-9]*) echo "duetto-turnuser: bad user" >&2; exit 2;; esac
realm=$(sed -n 's/^realm=//p' /etc/turnserver.conf | head -1)
[ -n "$realm" ] || { echo "duetto-turnuser: no realm in /etc/turnserver.conf" >&2; exit 2; }
case "$op" in
  add)
    case "$p" in ""|*[!A-Za-z0-9]*) echo "duetto-turnuser: bad password" >&2; exit 2;; esac
    [ ${#p} -ge 16 ] || { echo "duetto-turnuser: password too short" >&2; exit 2; }
    exec turnadmin -a -u "$u" -r "$realm" -p "$p"
    ;;
  del)
    exec turnadmin -d -u "$u" -r "$realm"
    ;;
  *) echo "usage: duetto-turnuser add <user> <password> | del <user>" >&2; exit 2;;
esac
