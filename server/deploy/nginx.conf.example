# Duetto - an nginx snippet to expose the signalling WebSocket with TLS.
# Put it inside a server{} already served over HTTPS on your domain.
#
#   The app will connect to:  wss://YOUR_DOMAIN/duetto/ws
#
# The signalling server runs locally on 127.0.0.1:8787 (see .env).

location /duetto/ws {
    proxy_pass http://127.0.0.1:8787;
    proxy_http_version 1.1;

    # Upgrade to WebSocket
    proxy_set_header Upgrade $http_upgrade;
    proxy_set_header Connection "upgrade";

    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;

    # Keep the connection alive for a long time (long calls)
    proxy_read_timeout 3600s;
    proxy_send_timeout 3600s;
}

location = /duetto/healthz {
    proxy_pass http://127.0.0.1:8787/healthz;
    proxy_set_header Host $host;
}
