# systemd unit per il signaling Duetto.
# Copia in /etc/systemd/system/duetto-signaling.service, poi:
#   sudo systemctl daemon-reload
#   sudo systemctl enable --now duetto-signaling
#
# Adatta User, WorkingDirectory e il percorso di node.

[Unit]
Description=Duetto signaling server (WebSocket)
After=network.target

[Service]
Type=simple
User=www-data
WorkingDirectory=/opt/duetto/server
EnvironmentFile=/opt/duetto/server/.env
ExecStart=/usr/bin/node src/index.js
Restart=on-failure
RestartSec=3
# Hardening di base
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=

[Install]
WantedBy=multi-user.target
