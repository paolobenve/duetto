# systemd unit for Duetto's signalling server.
# Copy to /etc/systemd/system/duetto-signaling.service, then:
#   sudo systemctl daemon-reload
#   sudo systemctl enable --now duetto-signaling
#
# Adjust User, WorkingDirectory and the path to node. The settings are
# in /etc/duetto/server.env and the list in /var/lib/duetto, away from
# the code: see docs/DEPLOY.md.
#
# BEWARE when copying this over an existing installation: the User
# below is an example, and the real one is whoever owns (or shares the
# group of) the working directory. Overwriting a tuned unit with this
# file, User included, is a mistake that has already been made once:
# the service died at CHDIR, as a stranger at the door.

[Unit]
Description=Duetto signaling server (WebSocket)
After=network.target
# Up after the reverse proxy, and so down BEFORE it: on the way out the
# server says goodbye to every phone ("server-shutdown"), and that word
# has to pass through the proxy. Stopped side by side, as at a reboot,
# the proxy went first and the phones saw a plain drop. Units that do
# not exist are ignored. On an installation whose unit is tuned, the
# same line goes in a drop-in instead - see DEPLOY.md.
After=haproxy.service apache2.service nginx.service
# Never give up: a crash-loop is slowed down by the backoff below, not
# stopped - a server that stays down until a human notices is worse.
# (In [Unit] and not [Service]: older systemd only knows it here.)
StartLimitIntervalSec=0

[Service]
Type=simple
User=www-data
WorkingDirectory=/opt/duetto/server
# Outside the code, which a deploy copies over, and root's: the service
# reads its settings and cannot change them - the key of the house
# among them.
EnvironmentFile=/etc/duetto/server.env
ExecStart=/usr/bin/node src/index.js
# `always` and not `on-failure`: the server deliberately exits on any
# uncaught error, and even a clean-but-wrong exit must not leave the
# phones without their meeting point. A crash-loop slows down to one
# try a minute - or stays at one every 3 s on systemd older than 254,
# which ignores the two backoff lines. Both are better than a server
# that stays down until a human notices.
Restart=always
RestartSec=3
RestartSteps=5
RestartMaxDelaySec=60
# Basic hardening
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
# The one place it may write: the list of the phones let in, and the
# invitations not yet used. With `strict` above the whole filesystem is
# read-only - which is what one wants of a server that only forwards
# envelopes, and was true of this one until it began keeping a list.
# The list is kept in /var/lib/duetto, made here for the service's user
# and writable without being named (DEVICES_FILE in the settings points
# there). It used to be kept beside the code, and the folder of the
# code was the writable one: whatever got to run as the service could
# have rewritten the code, or the settings, and stayed past a restart.
StateDirectory=duetto
StateDirectoryMode=0750

[Install]
WantedBy=multi-user.target
