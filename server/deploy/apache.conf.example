# Duetto - the signalling server behind Apache, on the domain you already
# have.
#
# These lines go INSIDE the <VirtualHost *:443> of your existing domain
# (the one already serving the site over HTTPS).
#
# Modules needed:
#   sudo a2enmod proxy proxy_http proxy_wstunnel rewrite
#
# Then:
#   sudo apachectl configtest && sudo systemctl reload apache2
#
# The app will connect to:  wss://YOUR_DOMAIN/duetto/ws
# The signalling server listens locally on 127.0.0.1:8787 (see .env).

# --- Signalling (WebSocket) ---
# Note: this RewriteRule has to come BEFORE any other rewrite rules of
# the site, otherwise it risks never being reached.
RewriteEngine On
RewriteCond %{HTTP:Upgrade} =websocket [NC]
RewriteRule ^/duetto/ws$ ws://127.0.0.1:8787/ [P,L]

# --- Health check (ordinary HTTP) ---
ProxyPass        /duetto/healthz http://127.0.0.1:8787/healthz
ProxyPassReverse /duetto/healthz http://127.0.0.1:8787/healthz

# The calls last a long time: the proxy must not close the connection.
ProxyTimeout 3600
