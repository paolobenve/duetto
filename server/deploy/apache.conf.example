# DuoTalk - signaling dietro Apache, sul dominio che hai gia'.
#
# Queste righe vanno DENTRO il <VirtualHost *:443> del tuo dominio
# esistente (quello che serve gia' il sito in HTTPS).
#
# Moduli richiesti:
#   sudo a2enmod proxy proxy_http proxy_wstunnel rewrite
#
# Poi:
#   sudo apachectl configtest && sudo systemctl reload apache2
#
# L'app si collegherà a:  wss://TUO_DOMINIO/duotalk/ws
# Il signaling ascolta in locale su 127.0.0.1:8787 (vedi .env).

# --- Signaling (WebSocket) ---
# Nota: questa RewriteRule deve venire PRIMA di eventuali altre regole
# di rewrite del sito, altrimenti rischia di non essere mai raggiunta.
RewriteEngine On
RewriteCond %{HTTP:Upgrade} =websocket [NC]
RewriteRule ^/duotalk/ws$ ws://127.0.0.1:8787/ [P,L]

# --- Health check (HTTP normale) ---
ProxyPass        /duotalk/healthz http://127.0.0.1:8787/healthz
ProxyPassReverse /duotalk/healthz http://127.0.0.1:8787/healthz

# Le chiamate durano a lungo: il proxy non deve chiudere la connessione.
ProxyTimeout 3600
