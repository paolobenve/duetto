# DuoTalk - VirtualHost Apache per ntfy su sottodominio.
#
# ntfy vuole stare sulla radice di un host, quindi gli diamo il suo
# sottodominio. Copia in /etc/apache2/sites-available/ntfy.conf,
# sostituisci TUO_DOMINIO, poi:
#
#   sudo a2enmod proxy proxy_http proxy_wstunnel rewrite headers ssl
#   sudo a2ensite ntfy
#   sudo certbot --apache -d ntfy.TUO_DOMINIO      (per il certificato)
#   sudo apachectl configtest && sudo systemctl reload apache2
#
# Presuppone ntfy in ascolto su 127.0.0.1:2586 (listen-http in server.yml).

<VirtualHost *:80>
    ServerName ntfy.TUO_DOMINIO
    # Tutto su HTTPS
    RewriteEngine On
    RewriteCond %{HTTPS} off
    RewriteRule ^/?(.*)$ https://%{SERVER_NAME}/$1 [R=301,L]
</VirtualHost>

<VirtualHost *:443>
    ServerName ntfy.TUO_DOMINIO

    SSLEngine on
    SSLCertificateFile    /etc/letsencrypt/live/ntfy.TUO_DOMINIO/fullchain.pem
    SSLCertificateKeyFile /etc/letsencrypt/live/ntfy.TUO_DOMINIO/privkey.pem

    # --- WebSocket ---
    # L'app ntfy resta connessa in WebSocket per ricevere subito le
    # notifiche: senza questo blocco arriverebbero solo con molto ritardo.
    RewriteEngine On
    RewriteCond %{HTTP:Upgrade} =websocket [NC]
    RewriteRule ^/?(.*)$ ws://127.0.0.1:2586/$1 [P,L]

    # --- Tutto il resto ---
    ProxyPass        / http://127.0.0.1:2586/
    ProxyPassReverse / http://127.0.0.1:2586/
    ProxyPreserveHost On

    # ntfy tiene connessioni aperte a lungo (streaming degli eventi):
    # con un timeout corto le notifiche si interromperebbero di continuo.
    ProxyTimeout 1200
    SetEnv proxy-sendchunked 1

    RequestHeader set X-Forwarded-Proto "https"

    ErrorLog  ${APACHE_LOG_DIR}/ntfy-error.log
    CustomLog ${APACHE_LOG_DIR}/ntfy-access.log combined
</VirtualHost>
