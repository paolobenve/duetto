# Duetto - coturn configuration (the fallback link).
#
# It is needed when the two phones cannot see each other directly:
# different networks, symmetric NATs, nearly always the mobile network. On
# the same wifi it never comes into play.
#
# Even going through the relay the traffic stays end-to-end encrypted:
# coturn forwards packets it cannot read.
#
# Copy to /etc/turnserver.conf, replace the THREE upper-case values, then:
#   sudo sed -i 's/#TURNSERVER_ENABLED=1/TURNSERVER_ENABLED=1/' /etc/default/coturn
#   sudo systemctl enable --now coturn

# --- Network ------------------------------------------------------------
listening-port=3478
tls-listening-port=5349

# BEWARE: coturn does NOT go through the reverse proxy. The phones talk to
# it directly on the ports below, so no 127.0.0.1.
#
# "external-ip" is needed ONLY if the server is behind NAT, that is if its
# interface has a private address. Check with:
#
#   ip -4 addr show scope global | grep -oP 'inet \K[\d.]+'
#   curl -4 -s ifconfig.me
#
# If the two match (a direct public IP, the case with nearly every VPS)
# leave this line commented out: coturn works it out by itself.
# If they differ, give both:  external-ip=PUBLIC/PRIVATE
#external-ip=YOUR_PUBLIC_IP

# The ports used for the relaying itself. They have to be opened on the
# firewall in UDP, and it is worth keeping them few: coturn's default is
# 49152-65535, sixteen thousand ports which for two people make no sense.
min-port=49160
max-port=49200

# --- Identity and credentials -------------------------------------------
realm=YOUR_DOMAIN
server-name=YOUR_DOMAIN

# Fixed credentials: for two people they are enough, and they are the ones
# you will put in TURN_USER / TURN_PASS in the signalling server's .env.
# There is no need to invent one:
#
#   openssl rand -hex 24
#
# Hexadecimal and not base64: the same strength (192 bits) but without +,
# / and =, which in configuration files and command lines cause trouble.
#
# If you lose it, it is written down here anyway:
#   sudo grep -oP '^user=duetto:\K.*' /etc/turnserver.conf
lt-cred-mech
user=duetto:PUT_A_LONG_PASSWORD_HERE

# --- TLS ----------------------------------------------------------------
# It reuses the certificates you already have. The service runs as the
# turnserver user, which has to be able to read them:
#   sudo setfacl -R -m u:turnserver:rX /etc/letsencrypt/live /etc/letsencrypt/archive
cert=/etc/letsencrypt/live/YOUR_DOMAIN/fullchain.pem
pkey=/etc/letsencrypt/live/YOUR_DOMAIN/privkey.pem

# --- Security -----------------------------------------------------------
# Without these lines the relay could be used by anybody to reach your
# internal network.
no-cli
no-multicast-peers
denied-peer-ip=0.0.0.0-0.255.255.255
denied-peer-ip=10.0.0.0-10.255.255.255
denied-peer-ip=127.0.0.0-127.255.255.255
denied-peer-ip=169.254.0.0-169.254.255.255
denied-peer-ip=172.16.0.0-172.31.255.255
denied-peer-ip=192.168.0.0-192.168.255.255

# Limits, so as not to leave the relay at the disposal of anybody who
# finds out the credentials: two phones do not use more than a few dozen.
user-quota=12
total-quota=100

# Log
log-file=/var/log/turnserver.log
simple-log
