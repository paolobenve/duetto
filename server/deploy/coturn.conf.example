# DuoTalk - configurazione coturn (collegamento di riserva).
#
# Serve quando i due telefoni non riescono a vedersi direttamente: reti
# diverse, NAT simmetrici, quasi sempre la rete mobile. Sulla stessa wifi
# non entra mai in gioco.
#
# Anche passando dal relay il traffico resta cifrato end-to-end: coturn
# inoltra pacchetti che non puo' leggere.
#
# Copia in /etc/turnserver.conf, sostituisci i TRE valori maiuscoli, poi:
#   sudo sed -i 's/#TURNSERVER_ENABLED=1/TURNSERVER_ENABLED=1/' /etc/default/coturn
#   sudo systemctl enable --now coturn

# --- Rete ---------------------------------------------------------------
listening-port=3478
tls-listening-port=5349

# ATTENZIONE: coturn NON passa dal reverse proxy. I telefoni gli parlano
# direttamente sulle porte qui sotto, quindi niente 127.0.0.1.
#
# "external-ip" serve SOLO se il server sta dietro NAT, cioe' se la sua
# interfaccia ha un indirizzo privato. Verifica con:
#
#   ip -4 addr show scope global | grep -oP 'inet \K[\d.]+'
#   curl -4 -s ifconfig.me
#
# Se i due coincidono (IP pubblico diretto, il caso di quasi tutti i VPS)
# lascia questa riga commentata: coturn se ne accorge da solo.
# Se sono diversi, indicali entrambi:  external-ip=PUBBLICO/PRIVATO
#external-ip=TUO_IP_PUBBLICO

# Porte usate per il relay vero e proprio. Vanno aperte sul firewall in
# UDP, e conviene tenerle poche: il valore predefinito di coturn e'
# 49152-65535, sedicimila porte che per due persone non hanno senso.
min-port=49160
max-port=49200

# --- Identita' e credenziali --------------------------------------------
realm=TUO_DOMINIO
server-name=TUO_DOMINIO

# Credenziali fisse: per due persone bastano, e sono quelle che metterai
# in TURN_USER / TURN_PASS nel .env del signaling. Non serve inventarla:
#
#   openssl rand -hex 24
#
# Esadecimale e non base64: stessa robustezza (192 bit) ma senza +, / e =,
# che in file di configurazione e righe di comando creano grattacapi.
#
# Se la perdi, e' comunque scritta qui sotto:
#   sudo grep -oP '^user=duotalk:\K.*' /etc/turnserver.conf
lt-cred-mech
user=duotalk:METTI_UNA_PASSWORD_LUNGA

# --- TLS ----------------------------------------------------------------
# Riusa i certificati che hai gia'. Il servizio gira come utente turnserver,
# che deve poterli leggere:
#   sudo setfacl -R -m u:turnserver:rX /etc/letsencrypt/live /etc/letsencrypt/archive
cert=/etc/letsencrypt/live/TUO_DOMINIO/fullchain.pem
pkey=/etc/letsencrypt/live/TUO_DOMINIO/privkey.pem

# --- Sicurezza ----------------------------------------------------------
# Senza queste righe il relay sarebbe utilizzabile da chiunque per
# raggiungere la tua rete interna.
no-cli
no-multicast-peers
denied-peer-ip=0.0.0.0-0.255.255.255
denied-peer-ip=10.0.0.0-10.255.255.255
denied-peer-ip=127.0.0.0-127.255.255.255
denied-peer-ip=169.254.0.0-169.254.255.255
denied-peer-ip=172.16.0.0-172.31.255.255
denied-peer-ip=192.168.0.0-192.168.255.255

# Limiti, per non lasciare il relay a disposizione di chiunque scopra le
# credenziali: due telefoni non ne usano piu' di qualche decina.
user-quota=12
total-quota=100

# Log
log-file=/var/log/turnserver.log
simple-log
