# Duetto - HAProxy in front of the signalling server.
#
# If port 443 is handled by HAProxy, it is worth sending /duetto/ STRAIGHT
# to the signalling server on 127.0.0.1:8787, without going through the
# rest of the chain (typically Varnish and then the web server).
#
# Two reasons, and not only convenience:
#  - Varnish does NOT handle WebSockets unless it is taught to "pipe"
#    requests carrying Upgrade;
#  - putting a cache in front of a signalling channel makes no sense.
#
# The app will connect to:  wss://YOUR_DOMAIN/duetto/ws


# ---------------------------------------------------------------------
# 1) In the frontend listening on 443, along with the other acls
# ---------------------------------------------------------------------

    acl duetto_path path_beg /duetto/
    use_backend duetto_backend if duetto_path

# The use_backend lines are evaluated in the order they are written, and
# in any case before default_backend: if you have other general
# use_backend lines, this one has to come first.


# ---------------------------------------------------------------------
# 2) A new backend, at the end of the file
# ---------------------------------------------------------------------

backend duetto_backend
    mode http

    # It overrides "option http-server-close" inherited from defaults:
    # that closes the connection on the server side after the answer,
    # which with a permanent connection is not what we want.
    option http-keep-alive

    # THE LINE THAT REALLY MATTERS.
    # After the upgrade to WebSocket the connection stays open and silent
    # for a long time. "timeout tunnel" replaces the client/server
    # timeouts once the tunnel is established; if you do not set it, it
    # inherits the ones from defaults (often 50 seconds) and presence
    # would drop constantly, with a symptom that is hard to trace back to
    # its cause.
    timeout tunnel 3600s
    timeout server 3600s

    server duetto 127.0.0.1:8787 check
