# Duetto - HAProxy davanti al signaling.
#
# Se la 443 e' gestita da HAProxy, conviene mandargli /duetto/ DIRETTAMENTE
# al signaling su 127.0.0.1:8787, senza passare dal resto della catena
# (tipicamente Varnish e poi il web server).
#
# Due motivi, non solo comodita':
#  - Varnish NON gestisce i WebSocket se non gli si insegna a fare "pipe"
#    sulle richieste con Upgrade;
#  - mettere una cache davanti a un canale di signaling non ha senso.
#
# L'app si collegherà a:  wss://TUO_DOMINIO/duetto/ws


# ---------------------------------------------------------------------
# 1) Nel frontend che ascolta sulla 443, insieme agli altri acl
# ---------------------------------------------------------------------

    acl duetto_path path_beg /duetto/
    use_backend duetto_backend if duetto_path

# Le use_backend si valutano nell'ordine di scrittura e comunque prima
# del default_backend: se hai altre use_backend generiche, questa deve
# venire prima.


# ---------------------------------------------------------------------
# 2) Backend nuovo, in fondo al file
# ---------------------------------------------------------------------

backend duetto_backend
    mode http

    # Scavalca "option http-server-close" ereditata da defaults: chiude la
    # connessione lato server dopo la risposta, cosa che con una
    # connessione permanente non vogliamo.
    option http-keep-alive

    # LA RIGA CHE CONTA DAVVERO.
    # Dopo l'upgrade a WebSocket la connessione resta aperta e silenziosa
    # a lungo. "timeout tunnel" sostituisce i timeout client/server una
    # volta stabilito il tunnel; se non lo imposti eredita quelli di
    # defaults (spesso 50 secondi) e la presenza cadrebbe di continuo,
    # con un sintomo difficile da ricondurre alla causa.
    timeout tunnel 3600s
    timeout server 3600s

    server duetto 127.0.0.1:8787 check
