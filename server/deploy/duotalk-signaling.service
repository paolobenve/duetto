# systemd unit per il signaling DuoTalk.
# Copia in /etc/systemd/system/duotalk-signaling.service, poi:
#   sudo systemctl daemon-reload
#   sudo systemctl enable --now duotalk-signaling
#
# Adatta User, WorkingDirectory e il percorso di node.

[Unit]
Description=DuoTalk signaling server (WebSocket)
After=network.target

[Service]
Type=simple
User=www-data
WorkingDirectory=/opt/duotalk/server
EnvironmentFile=/opt/duotalk/server/.env
ExecStart=/usr/bin/node src/index.js
Restart=on-failure
RestartSec=3
# Hardening di base
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=

[Install]
WantedBy=multi-user.target
