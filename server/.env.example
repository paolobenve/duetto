# Copy to .env and adjust. Load it with: `set -a; . ./.env; set +a`, or
# through systemd.

# Local port (it stays on loopback: the reverse proxy exposes it with TLS)
PORT=8787
HOST=127.0.0.1


# How many knocks a minute from one address, from phones this server does
# not know. Those it knows are not counted: at home they all share one
# address, and after a restart they come back together.
#JOIN_LIMIT=120
#JOIN_LIMIT_ALL=600   # and for everybody together, per minute

# --- The key of the house ---
# Without it, anybody who learns this server's address can use it: open
# rooms of their own and - worse - be handed the TURN credentials below
# in the very first message, which is your bandwidth paid by you.
#
# The door shuts by itself: the first phone that knocks at a server
# nobody has taken becomes its owner. On a public address that first
# phone may not be yours: with this set, the first knock has to know
# the word. And it brings the owner home: a reinstalled phone is known
# by a new card, and with the key it is written down as the owner
# again - without it, the way in is a terminal.
#
# The app asks for it only when this server does. It is not an identity
# and it protects nothing of the conversation: whoever has it can take
# this house, and no further. What keeps a pair apart from everybody
# else is the pairing code, which never reaches this server.
#
#   openssl rand -hex 12
#
# Left empty, the first card at the door takes the house.
SERVER_KEY=

# --- The phones allowed in, one key each ---
# A key of the house is a word, and a word gets repeated: it cannot be
# taken back from one person without changing it for everybody, and when
# it turns up elsewhere there is no telling who passed it on.
#
# A phone carries a key of its own. The secret half never leaves it;
# the public half - the card - is what this server writes down, and at
# every connection it picks a number and the phone signs it. Normally
# it is written down by the server itself, in devices.json: the first
# card at the door takes the house, the others come in by invitation.
# Here the same list can be kept by hand, for whoever prefers a file of
# their own; the cards are in devices.json and in the log.
#
#   AUTHORISED_KEYS=anna:BASE64DIANNA,bruno:BASE64DIBRUNO
#
# To take one phone away, its entry goes and nobody else notices. The
# log says which name came in, not just that somebody did.
AUTHORISED_KEYS=

# Where the phones this server has written down are kept - the owner,
# whoever came in by invitation, the guests of each room - and the
# invitations not yet used. Beside the server unless said otherwise.
#DEVICES_FILE=/var/wwwc/duetto/server/devices.json
# How long an invitation is worth, in days.
#INVITE_DAYS=7

# --- The fallback link (TURN) ---
# It is needed when the two phones are on different networks and cannot
# see each other directly: without it the link stays in "connecting" and
# ends up "failed". On the same wifi it never comes into play.
#
# It is configured HERE and not on the phones: the server tells the app.
# The credentials are the ones written in /etc/turnserver.conf (user=...).
#
# TLS alone, on purpose. A carrier's shared NAT was watched killing
# every non-web flow on a forty-second clock - UDP and plain TCP alike,
# relayed legs included - while TLS went untouched: it is the one dress
# such networks respect. And the dress costs nothing where it is not
# needed: with a direct road the relay carries no traffic at all, so
# its clothing only matters on the very networks that made the relay
# necessary. It needs the certificate lines in coturn's own config
# (deploy/coturn.conf.example) and the renewal hook that keeps the
# certificate copy fresh (deploy/letsencrypt-coturn-hook.sh).
TURN_URL=turns:YOUR_DOMAIN:5349?transport=tcp
TURN_USER=duetto
TURN_PASS=

# A relay user per phone (see deploy/duetto-turnuser and DEPLOY.md):
# the phones get credentials of their own, made the first time they are
# let in and dropped when they go. Without this line the shared one
# above serves everybody.
#TURN_ADMIN_CMD=sudo -n /usr/local/sbin/duetto-turnuser

# The STUN of the house. It is NEEDED: without it the phones never
# learn their own public address, and two different networks cannot
# even try to meet directly. It cannot be derived from the relay's
# address any more - the TLS port is another one - so it is named
# here. coturn answers STUN on its plain port, no credentials
# involved. Nothing falls back on anybody else's server: everything
# the phones use is yours.
STUN_URL=stun:YOUR_DOMAIN:3478

# The notifications do not go through any outside service: it is the app
# itself that shows them when the server alerts it over the connection it
# keeps open.

# --- Heartbeat (usually not touched) ----------------------------------
# How often the server taps the phones on the shoulder, in milliseconds.
# It is there to find dead connections and to keep the operator's NAT
# mapping alive, but the phone pays for it: every packet wakes its radio.
# Close together only for whoever is in the channel, far apart for
# whoever is listening.
#
# Raising HEARTBEAT_LISTENING_MS costs less battery; raise it too far and
# the operator's NAT closes the way through while the phone still
# believes it can be reached. To be changed only after measuring.
#HEARTBEAT_ACTIVE_MS=30000
#HEARTBEAT_LISTENING_MS=240000
