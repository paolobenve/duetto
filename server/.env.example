# Copia in .env e personalizza. Caricalo con: `set -a; . ./.env; set +a` oppure via systemd.

# Porta locale (resta su loopback: lo espone il reverse proxy con TLS)
PORT=8787
HOST=127.0.0.1

# Token anti-abuso, FACOLTATIVO. Lasciandolo vuoto non viene richiesto.
#
# Di norma non serve: senza il codice di accoppiamento non si entra in
# nessuna coppia, e senza la chiave non si decifra nulla. Il token
# impedirebbe solo di aprire connessioni inutili al server.
#
# Se lo imposti (openssl rand -base64 32) va messo anche nell'app, su
# entrambi i telefoni, sotto "Altre impostazioni".
ACCESS_TOKEN=

# --- Collegamento di riserva (TURN) ---
# Serve quando i due telefoni sono su reti diverse e non riescono a
# vedersi direttamente: senza, il collegamento resta in "connecting" e
# finisce in "failed". Sulla stessa wifi non entra mai in gioco.
#
# Si configura QUI e non sui telefoni: il server lo comunica all'app.
# Le credenziali sono quelle scritte in /etc/turnserver.conf (user=...).
TURN_URL=turn:TUO_DOMINIO:3478
TURN_USER=duotalk
TURN_PASS=

# Le notifiche non passano da servizi esterni: e' l'app stessa a
# mostrarsele quando il server la avvisa sulla connessione sempre aperta.
