# Copia in .env e personalizza. Caricalo con: `set -a; . ./.env; set +a` oppure via systemd.

# Porta locale (resta su loopback: lo espone il reverse proxy con TLS)
PORT=8787
HOST=127.0.0.1

# Token condiviso anti-abuso, uguale sui due telefoni.
# Genera con:  openssl rand -base64 32
ACCESS_TOKEN=

# Non serve altro: le notifiche non passano da servizi esterni, e' l'app
# stessa a mostrarsele quando il server la avvisa sulla connessione che
# tiene sempre aperta.
