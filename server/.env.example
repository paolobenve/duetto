# Copia in .env e personalizza. Caricalo con: `set -a; . ./.env; set +a` oppure via systemd.

# --- Signaling ---
# Porta locale (resta su loopback: lo espone il reverse proxy con TLS)
PORT=8787
HOST=127.0.0.1

# Token condiviso anti-abuso. Mettine uno lungo e casuale, uguale sui due telefoni.
# Genera con:  openssl rand -base64 32
ACCESS_TOKEN=

# --- Notifiche push (ntfy self-hosted) ---
# URL del TUO server ntfy. Se lo lasci vuoto, le notifiche sono disattivate
# (l'app funziona lo stesso, ma non avvisa l'altro ad app chiusa).
NTFY_URL=https://ntfy.TUO_DOMINIO

# Token di accesso ntfy, se hai attivato l'autenticazione (consigliato).
# Si crea con:  ntfy token add duotalk
NTFY_TOKEN=

# Deep link aperto toccando la notifica (deve combaciare con l'AndroidManifest)
DEEP_LINK=duotalk://channel
