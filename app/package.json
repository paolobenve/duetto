{
  "name": "Duetto",
  "version": "0.1.0",
  "private": true,
  "license": "GPL-3.0-or-later",
  "scripts": {
    "sync": "node scripts/sync-local-modules.js",
    "patch": "node scripts/patch-android-manifest.js && node scripts/patch-android-gradle.js && node scripts/patch-android-theme.js && node scripts/patch-android-mainactivity.js && node scripts/patch-android-icon.js",
    "android": "npm run sync && npm run patch && npm run bump && react-native run-android",
    "start": "react-native start",
    "build:apk": "npm run sync && npm run patch && npm run bump && cd android && ./gradlew assembleRelease",
    "lint": "eslint .",
    "tsc": "tsc --noEmit",
    "postinstall": "node scripts/sync-local-modules.js",
    "bump": "node scripts/bump-build.js"
  },
  "dependencies": {
    "@react-native-async-storage/async-storage": "^2.1.0",
    "duetto-platform": "file:modules/duetto-platform",
    "qrcode": "^1.5.4",
    "react": "18.3.1",
    "react-native": "0.76.5",
    "react-native-get-random-values": "^1.11.0",
    "react-native-incall-manager": "^4.2.0",
    "react-native-svg": "^15.15.5",
    "react-native-webrtc": "^124.0.5",
    "tweetnacl": "^1.0.3",
    "tweetnacl-util": "^0.15.1"
  },
  "devDependencies": {
    "@babel/core": "^7.25.0",
    "@babel/preset-env": "^7.25.0",
    "@babel/runtime": "^7.25.0",
    "@react-native-community/cli": "15.0.1",
    "@react-native-community/cli-platform-android": "15.0.1",
    "@react-native/babel-preset": "0.76.5",
    "@react-native/eslint-config": "0.76.5",
    "@react-native/metro-config": "0.76.5",
    "@react-native/typescript-config": "0.76.5",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^18.3.12",
    "eslint": "^8.57.0",
    "prettier": "^3.3.3",
    "typescript": "5.6.3"
  },
  "engines": {
    "node": ">=18"
  }
}
