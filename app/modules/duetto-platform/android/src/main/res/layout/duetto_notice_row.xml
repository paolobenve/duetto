<?xml version="1.0" encoding="utf-8"?>
<!-- One connection: how it stands, and its two buttons - Call, then
     Enter (or Go to waiting), Enter last. The words whole, however many
     lines they take beside the buttons: cut with dots, on 16 October,
     the line in use lost the other's time. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="center_vertical"
    android:orientation="horizontal">

    <TextView
        android:id="@+id/duetto_row_text"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:textAppearance="@style/TextAppearance.Compat.Notification" />

    <TextView
        android:id="@+id/duetto_row_alert"
        style="@style/DuettoNoticeButton" />

    <TextView
        android:id="@+id/duetto_row_enter"
        style="@style/DuettoNoticeButton" />
</LinearLayout>
