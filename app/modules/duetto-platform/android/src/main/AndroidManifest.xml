<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Staying alive in the background -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MICROPHONE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_CAMERA" />
    <!-- For listening without an interface, which uses neither the
         microphone nor the camera: it holds a connection open and waits. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <!-- Android 13+: needed to show the service's notification -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- Coming back after the phone reboots -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <!-- Asking for unrestricted battery use -->
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />

    <application>
        <!-- Presence with no interface: it puts the connection back up
             after a reboot, without opening the app (forbidden from
             Android 10).

             The type is NOT "microphone": this service never opens the
             microphone - it holds a connection and waits - and declaring
             it was wrong in itself. It was also fatal: from Android 14 an
             app that is not in the foreground cannot start a service of
             the microphone type, and we start it exactly when the
             interface has just disappeared. The system threw an exception
             and the app died.

             "dataSync" would be the other obvious choice, but from
             Android 15 it has a ceiling of six hours a day, and this
             presence has to be able to stay on all night. -->
        <service
            android:name=".PresenceService"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="Stay reachable for the other person's call" />
        </service>

        <receiver
            android:name=".BootReceiver"
            android:exported="true"
            android:enabled="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.LOCKED_BOOT_COMPLETED" />
                <action android:name="android.intent.action.QUICKBOOT_POWERON" />
            </intent-filter>
        </receiver>

        <!-- No `stopWithTask`: it told Android to shut the service down
             when the phone puts the app away, and that is exactly the
             moment presence has to stay. Whoever does not want to be
             reachable has "leave and become unavailable", which says so
             in so many words. -->
        <service
            android:name=".ChannelForegroundService"
            android:exported="false"
            android:foregroundServiceType="microphone|camera" />
    </application>
</manifest>
